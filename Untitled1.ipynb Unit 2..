      "source": [
        "import numpy as np\n",
        "from scipy.integrate import fixed_quad\n",
        "\n",
        "\n",
        "def f(x):\n",
        "    return x**2 * np.exp(x)\n",
        "\n",
        "\n",
        "result, _ = fixed_quad(f, 0, 1, n=5)\n",
        "print(\"Gauss-Legendre Integration Result:\", result)\n",
        "\n",
        "\n",
        "x_vals = np.linspace(-1, 1, 100)\n",
        "y_vals = np.sin(x_vals)\n",
        "\n",
        "\n",
        "coef = np.polynomial.legendre.legfit(x_vals, y_vals, deg=3)\n",
        "print(\"Legendre Polynomial Coefficients:\", coef)"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "from scipy.special import roots_laguerre, roots_hermite\n",
        "\n",
        "n = 5\n",
        "nodes, weights = roots_laguerre(n)\n",
        "integral_laguerre = np.sum(weights * (1 / (1 + nodes**2)))\n",
        "print(\"Gauss-Laguerre Integral Result:\", integral_laguerre)\n",
        "\n",
        "nodes_h, weights_h = roots_hermite(n)\n",
        "integral_hermite = np.sum(weights_h * np.cos(nodes_h))\n",
        "print(\"Gauss-Hermite Integral Result:\", integral_hermite)"
      ],
